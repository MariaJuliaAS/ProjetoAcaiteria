<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f5f3f5;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.controller.ProdutosController">

   <left>
      <fx:include source="sidebar.fxml" fx:id="sidebar" />
   </left>

   <center>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
         </padding>
         <children>

            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Produtos" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnNovoProduto" mnemonicParsing="false" onAction="#abrirNovoProduto" style="-fx-background-color: #8bc34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="+  Novo Produto">
                     <padding>
                        <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <TextField fx:id="txtBusca" maxWidth="400.0" promptText="Buscar produto..." style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px;">
                     <padding>
                        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
                     </padding>
                  </TextField>
                  <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProduto" style="-fx-background-color: #8bc34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Buscar">
                     <padding>
                        <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
                     </padding>
                  </Button>
                  <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#limparBusca" style="-fx-background-color: #e0d8e3; -fx-text-fill: #5c2d6b; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Limpar">
                     <padding>
                        <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <FlowPane fx:id="containerProdutos" hgap="20.0" vgap="20.0" style="-fx-background-color: transparent;" />
               </content>
            </ScrollPane>

         </children>
      </VBox>
   </center>

</BorderPane>
