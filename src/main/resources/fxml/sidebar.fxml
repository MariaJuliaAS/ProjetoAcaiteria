<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="sidebarRoot" prefHeight="650.0" prefWidth="220.0" style="-fx-background-color: #4a1d5c;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.controller.SidebarController">
   <children>

      <HBox alignment="CENTER" spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Ju Maromba" />
                  <Label style="-fx-text-fill: #c9aed8; -fx-font-size: 11px;" text="Sistema de Açaí" />
               </children>
            </VBox>
         </children>
      </HBox>

      <VBox spacing="6.0">
         <padding>
            <Insets left="14.0" right="14.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px;" text="📊  Dashboard" />
            <Button fx:id="btnPedidos" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px;" text="🛒  Pedidos" />
            <Button fx:id="btnClientes" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px;" text="👥  Clientes" />
            <Button fx:id="btnProdutos" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px;" text="📦  Produtos" />
            <Button fx:id="btnAdicionais" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px;" text="🍓  Adicionais" />
            <Button fx:id="btnRelatorios" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px;" text="📈  Relatórios" />
            <Button fx:id="btnFuncionarios" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px;" text="🧑‍🤝‍🧑  Funcionários" />
         </children>
      </VBox>

      <Region VBox.vgrow="ALWAYS" />

      <VBox spacing="10.0" style="-fx-border-color: #6b2d7a transparent transparent transparent; -fx-border-width: 1px;">
         <padding>
            <Insets bottom="16.0" left="14.0" right="14.0" top="14.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <VBox spacing="1.0">
                     <children>
                        <Label fx:id="lblNomeUsuario" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;" text="Nome" />
                        <Label fx:id="lblCargoUsuario" style="-fx-text-fill: #c9aed8; -fx-font-size: 11px;" text="Cargo" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Button fx:id="btnSair" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sair" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 6px;" text="↪  Sair" />
         </children>
      </VBox>

   </children>
</VBox>
