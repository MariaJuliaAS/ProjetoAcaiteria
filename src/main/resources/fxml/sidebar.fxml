<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox fx:id="sidebarRoot" prefHeight="650.0" prefWidth="220.0" style="-fx-background-color: #4a1d5c;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.controller.SidebarController">
   <children>

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Circle fill="#8bc34a" radius="16.0" />
            <VBox spacing="2.0">
               <children>
                  <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Ju Maromba" />
                  <Label style="-fx-text-fill: #c9aed8; -fx-font-size: 11px;" text="Sistema de Açaí" />
               </children>
            </VBox>
         </children>
      </HBox>

      <VBox spacing="6.0">
         <padding>
            <Insets left="14.0" right="14.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #e0d0e8; -fx-font-size: 13px;" text="📊  Dashboard">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="btnPedidos" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irParaPedidos" style="-fx-background-color: transparent; -fx-text-fill: #e0d0e8; -fx-font-size: 13px;" text="🛒  Pedidos">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="btnClientes" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irParaClientes" style="-fx-background-color: transparent; -fx-text-fill: #e0d0e8; -fx-font-size: 13px;" text="👥  Clientes">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="btnProdutos" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irParaProdutos" style="-fx-background-color: transparent; -fx-text-fill: #e0d0e8; -fx-font-size: 13px;" text="📦  Produtos">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="btnAdicionais" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irParaAdicionais" style="-fx-background-color: transparent; -fx-text-fill: #e0d0e8; -fx-font-size: 13px;" text="🍓  Adicionais">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="btnRelatorios" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irParaRelatorios" style="-fx-background-color: transparent; -fx-text-fill: #e0d0e8; -fx-font-size: 13px;" text="📈  Relatórios">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="btnFuncionarios" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #e0d0e8; -fx-font-size: 13px;" text="🧑‍🤝‍🧑  Funcionários">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
         </children>
      </VBox>

      <Region VBox.vgrow="ALWAYS" />

      <VBox spacing="10.0" style="-fx-border-color: #6b2d7a transparent transparent transparent; -fx-border-width: 1px;">
         <padding>
            <Insets bottom="16.0" left="14.0" right="14.0" top="14.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Circle fill="#8e6a9c" radius="14.0" />
                  <VBox spacing="1.0">
                     <children>
                        <Label fx:id="lblNomeUsuario" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;" text="Nome" />
                        <Label fx:id="lblCargoUsuario" style="-fx-text-fill: #c9aed8; -fx-font-size: 11px;" text="Cargo" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Button fx:id="btnSair" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sair" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 6px;" text="↪  Sair">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
         </children>
      </VBox>

   </children>
</VBox>
