<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="16.0"
      style="-fx-background-color: white; -fx-background-radius: 12px;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.edu.ufersa.controller.ModalNotaFiscalController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="Nota Fiscal"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnFechar" text="✕" onAction="#fechar"
                        style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: #555555; -fx-cursor: hand;" />
            </children>
        </HBox>

        <TextArea fx:id="txtNota" editable="false" prefHeight="400.0"
                  style="-fx-font-family: monospace; -fx-font-size: 13px; -fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px;" />

    </children>
</VBox>