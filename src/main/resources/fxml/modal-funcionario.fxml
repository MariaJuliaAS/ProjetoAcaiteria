<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="modalRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="420.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 12px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.controller.ModalFuncionarioController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>

      <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblTitulo" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Novo Funcionário" />
      </HBox>

      <VBox spacing="6.0">
         <children>
            <Label style="-fx-font-size: 13px; -fx-text-fill: #444444;" text="Nome" />
            <TextField fx:id="txtNome" style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px;">
               <padding>
                  <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
               </padding>
            </TextField>
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <Label style="-fx-font-size: 13px; -fx-text-fill: #444444;" text="Usuário" />
            <TextField fx:id="txtLogin" style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px;">
               <padding>
                  <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
               </padding>
            </TextField>
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <Label style="-fx-font-size: 13px; -fx-text-fill: #444444;" text="Senha" />
            <PasswordField fx:id="txtSenha" style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px;">
               <padding>
                  <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
               </padding>
            </PasswordField>
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <Label style="-fx-font-size: 13px; -fx-text-fill: #444444;" text="Cargo" />
            <ComboBox fx:id="cmbCargo" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px;" />
         </children>
      </VBox>

      <Button fx:id="btnSalvar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#salvar" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8px; -fx-cursor: hand;" text="Adicionar">
         <padding>
            <Insets bottom="12.0" top="12.0" />
         </padding>
      </Button>

   </children>
</VBox>
