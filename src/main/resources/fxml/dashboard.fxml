<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f5f3f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.controller.DashboardController">

   <left>
      <fx:include fx:id="sidebar" source="sidebar.fxml" />
   </left>

   <center>
      <VBox spacing="24.0">
         <padding>
            <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
         </padding>
         <children>

            <VBox spacing="4.0">
               <children>
                  <Label fx:id="lblSaudacao" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Olá!" />
                  <Label style="-fx-font-size: 14px; -fx-text-fill: #888888;" text="Aqui está o resumo do seu dia" />
               </children>
            </VBox>

            <HBox spacing="20.0">
               <children>

                  <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 12px;" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-background-color: #f1e6f4; -fx-background-radius: 8px; -fx-padding: 6px 10px;" text="🛒" />
                        <Label fx:id="lblQtdPedidos" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="0" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Pedidos" />
                     </children>
                  </VBox>

                  <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 12px;" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-background-color: #f1e6f4; -fx-background-radius: 8px; -fx-padding: 6px 10px;" text="📈" />
                        <Label fx:id="lblFaturamento" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="R\$ 0,00" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Faturamento Hoje" />
                     </children>
                  </VBox>

                  <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 12px;" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-background-color: #f1e6f4; -fx-background-radius: 8px; -fx-padding: 6px 10px;" text="👥" />
                        <Label fx:id="lblQtdClientes" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="0" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Clientes" />
                     </children>
                  </VBox>

                  <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 12px;" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-background-color: #f1e6f4; -fx-background-radius: 8px; -fx-padding: 6px 10px;" text="🍓" />
                        <Label fx:id="lblQtdProdutos" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="0" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Produtos" />
                     </children>
                  </VBox>

               </children>
            </HBox>

            <VBox spacing="14.0">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Ações Rápidas" />

                  <HBox spacing="20.0">
                     <children>

                        <Button fx:id="btnNovoPedido" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#irParaNovoPedido" style="-fx-background-color: white; -fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #e0e0e0; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-cursor: hand;" text="Novo Pedido" HBox.hgrow="ALWAYS">
                           <padding>
                              <Insets bottom="14.0" left="14.0" right="18.0" top="14.0" />
                           </padding>
                           <graphic>
                              <Label style="-fx-background-color: #8bc34a; -fx-background-radius: 8px; -fx-padding: 8px 11px; -fx-font-size: 14px;" text="➕" />
                           </graphic>
                        </Button>

                        <Button fx:id="btnNovoCliente" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#irParaNovoCliente" style="-fx-background-color: white; -fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #e0e0e0; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-cursor: hand;" text="Novo Cliente" HBox.hgrow="ALWAYS">
                           <padding>
                              <Insets bottom="14.0" left="14.0" right="18.0" top="14.0" />
                           </padding>
                           <graphic>
                              <Label style="-fx-background-color: #4a1d5c; -fx-background-radius: 8px; -fx-padding: 8px 11px; -fx-font-size: 14px; -fx-text-fill: white;" text="➕" />
                           </graphic>
                        </Button>

                        <Button fx:id="btnBuscarPedido" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#irParaBuscarPedido" style="-fx-background-color: white; -fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #e0e0e0; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-cursor: hand;" text="Buscar Pedido" HBox.hgrow="ALWAYS">
                           <padding>
                              <Insets bottom="14.0" left="14.0" right="18.0" top="14.0" />
                           </padding>
                           <graphic>
                              <Label style="-fx-background-color: #f1e6f4; -fx-background-radius: 8px; -fx-padding: 8px 11px; -fx-font-size: 14px;" text="📦" />
                           </graphic>
                        </Button>

                        <Button fx:id="btnVerEstoque" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#irParaVerEstoque" style="-fx-background-color: white; -fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #e0e0e0; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-cursor: hand;" text="Ver Estoque" HBox.hgrow="ALWAYS">
                           <padding>
                              <Insets bottom="14.0" left="14.0" right="18.0" top="14.0" />
                           </padding>
                           <graphic>
                              <Label style="-fx-background-color: #d8c2e0; -fx-background-radius: 8px; -fx-padding: 8px 11px; -fx-font-size: 14px;" text="🍓" />
                           </graphic>
                        </Button>

                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </center>

</BorderPane>
