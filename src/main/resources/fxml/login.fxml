<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #eeecf3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.controller.LoginController">

    <children>

        <VBox alignment="CENTER" maxHeight="520.0" maxWidth="400.0" spacing="0" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 4);">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
            </padding>
            <children>

                <VBox alignment="CENTER">
                    <children>
                        <Label style="-fx-background-color: #6b2d7a; -fx-background-radius: 12px; -fx-font-size: 24px; -fx-padding: 12px 14px;" text="🍦" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="16.0" />
                    </VBox.margin>
                </VBox>

                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #6b2d7a;" text="Ju Maromba" />

                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Sistema de Gerenciamento de Açaí">
                    <VBox.margin>
                        <Insets bottom="24.0" top="4.0" />
                    </VBox.margin>
                </Label>
            <VBox>
               <children>
      
                      <Label style="-fx-font-size: 13px; -fx-text-fill: #444444;" text="Usuário" />
                      <TextField fx:id="txtUsuario" prefWidth="200.0" promptText="admin" style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px; -fx-font-size: 13px;">
                          <padding>
                              <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                          </padding>
                      </TextField>
                  <Region prefHeight="2.0" prefWidth="200.0" />
               </children>
            </VBox>
            <VBox>
               <children>
      
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #444444;" text="Senha" />
                      <PasswordField fx:id="txtSenha" promptText="••••••••" style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px; -fx-font-size: 13px;">
                          <padding>
                              <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                          </padding>
                      </PasswordField>
                  <Region prefHeight="22.0" prefWidth="200.0" />
               </children>
            </VBox>

                <Button fx:id="btnEntrar" maxWidth="1.7976931348623157E308" onAction="#entrar" style="-fx-background-color: #6b2d7a; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Entrar">
                    <padding>
                        <Insets bottom="12.0" top="12.0" />
                    </padding>
                </Button>

            </children>
        </VBox>

    </children>
</StackPane>
