<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f5f3f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.controller.PedidosController">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml" />
    </left>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Pedidos" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnNovoPedido" onAction="#abrirNovoPedido" style="-fx-background-color: #8bc34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand; -fx-font-size: 13px;" text="+ Novo Pedido">
                            <padding>
                                <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>

                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10px; -fx-border-color: #e0e0e0; -fx-border-radius: 10px;">
                    <padding>
                        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                    </padding>
                    <children>

                        <Label style="-fx-text-fill: #737373; -fx-font-size: 13px;" text="Pesquisar por:" />

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <TextField fx:id="txtBusca" promptText="Digite uma data (dd/MM/yyyy) ou nome do cliente..." style="-fx-background-radius: 8px; -fx-border-color: #d8d0db; -fx-border-radius: 8px;" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
                                    </padding>
                                </TextField>
                                <Button fx:id="btnBuscarPorData" onAction="#buscarPedidoPorData" style="-fx-background-color: #e0d8e3; -fx-text-fill: #5c2d6b; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Por Data">
                                    <padding>
                                        <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                                    </padding>
                                </Button>
                                <Button fx:id="btnBuscarPorCliente" onAction="#buscarPedidoPorCliente" style="-fx-background-color: #e0d8e3; -fx-text-fill: #5c2d6b; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Por Cliente">
                                    <padding>
                                        <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <ComboBox fx:id="cmbProduto" minWidth="372.0" prefHeight="27.0" prefWidth="372.0" promptText="Selecione um produto..." style="-fx-background-color: #FAFAFA; -fx-border-color: #d8d0db; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnBuscarPorProduto" onAction="#buscarPedidoPorProduto" style="-fx-background-color: #e0d8e3; -fx-text-fill: #5c2d6b; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Por Produto">
                                    <padding>
                                        <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                                    </padding>
                                </Button>
                                <Button fx:id="btnLimpar" onAction="#limparBusca" style="-fx-background-color: #f5f5f5; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Limpar">
                                    <padding>
                                        <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="containerPedidos" hgap="0" prefWrapLength="9999" style="-fx-background-color: transparent;" vgap="12.0" />
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </center>

</BorderPane>
